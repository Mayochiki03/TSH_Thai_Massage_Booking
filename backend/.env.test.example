# =====================================================================
# ตั้งค่าสำหรับ npm test — คัดลอกเป็น backend/.env.test แล้วแก้พอร์ตให้ตรงเครื่อง
# (.env.test ไม่ขึ้น GitHub)
#
# สร้าง user ทดสอบก่อน: database/setup_test_user.sql
# ⚠ TEST_DB_NAME ต้องลงท้ายด้วย _test — test ล้างฐานข้อมูลนี้ทิ้งทุกครั้งที่รัน
# =====================================================================
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_USER=massage_test
TEST_DB_PASSWORD=Test_Only_2026!
TEST_DB_NAME=thai_massage_booking_test

# พอร์ตของ backend ตอนรัน test (คนละพอร์ตกับ 4000/4001 → เปิดระบบจริงทิ้งไว้ระหว่างรัน test ได้)
TEST_PUBLIC_PORT=4100
TEST_INTERNAL_PORT=4101
